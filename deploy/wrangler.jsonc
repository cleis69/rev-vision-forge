// Static deployment of the prerendered site (bun run build:static) on Cloudflare.
// Kept out of the repo root so Lovable's own build ignores it.
// The Worker only runs for /media/* (byte ranges for Safari video playback)
// for the private AI agent page (password, secret AGENT_PASSWORD), for the
// promoter space /app, the public programme pages /p/… and their plan for
// iframes /embed/… (SPA shell).
{
  "name": "realestatevision360",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  // www is redirected to the apex by a Cloudflare redirect rule on the zone.
  "routes": [{ "pattern": "realestatevision360.com", "custom_domain": true }],
  "workers_dev": true,
  // Link previews of the public pages read Supabase with the publishable key,
  // the same one the site's JavaScript already carries (RLS decides access).
  "vars": {
    "SUPABASE_URL": "https://hbihlcnhmjommcnpujam.supabase.co",
    "SUPABASE_KEY": "sb_publishable_RWzgJ5zeKV7Ke0x-KRrTDg_LPLR-8_V"
  },
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/media/*",
      "/app",
      "/app/*",
      "/p/*",
      "/embed/*",
      "/agent-ia",
      "/agent-ia.html",
      "/agent-ia/*",
      "/en/ai-agent",
      "/en/ai-agent.html",
      "/en/ai-agent/*"
    ]
  }
}
